"""Learn2Earn Equipment Lending System (standard library only)."""
import json
import os
import sys

DATA_FILE = "learn2earn_data.json"
LOW_STOCK_LIMIT = 3

resources = [
    {"id": "R001", "name": "Laptop", "category": "Electronics", "total": 10, "available": 10},
    {"id": "R002", "name": "Keyboard", "category": "Accessories", "total": 5, "available": 5},
    {"id": "R003", "name": "Headset", "category": "Accessories", "total": 3, "available": 3},
]
fellows = {"F001": "Ada", "F002": "John", "F003": "Grace"}
# Each record: {"record_id", "fellow_id", "resource_id", "quantity", "returned"}
borrow_records = []


# ---------- helpers ----------
def find_resource(resource_id):
    for r in resources:
        if r["id"] == resource_id:
            return r
    return None


def parse_positive_int(text):
    """Return a positive int, or None if text is not one (rejects 2.5, abc, 0, -1)."""
    try:
        value = int(str(text).strip())
    except ValueError:
        return None
    return value if value > 0 else None


def outstanding(fellow_id, resource_id):
    """Units this fellow currently has on loan for this resource."""
    return sum(rec["quantity"] - rec["returned"]
               for rec in borrow_records
               if rec["fellow_id"] == fellow_id and rec["resource_id"] == resource_id)


# ---------- inventory ----------
def add_resource(resource_id, name, category, total):
    resource_id, name, category = resource_id.strip(), name.strip(), category.strip()
    if not resource_id or not name or not category:
        return False, "ID, name and category cannot be empty."
    if find_resource(resource_id):
        return False, f"Resource ID {resource_id} already exists."
    total = parse_positive_int(total)
    if total is None:
        return False, "Total units must be a positive whole number."
    resources.append({"id": resource_id, "name": name, "category": category,
                      "total": total, "available": total})
    return True, f"Added {name} ({resource_id}) with {total} units."


def format_resource(r):
    return (f"{r['id']:<6} {r['name']:<12} {r['category']:<12} "
            f"total={r['total']:<3} available={r['available']}")


def list_resources(items=None):
    items = resources if items is None else items
    if not items:
        print("  (no resources found)")
    for r in items:
        print("  " + format_resource(r))


# ---------- borrowing and returns ----------
def borrow(fellow_id, resource_id, quantity):
    """Validate everything first; only then change state."""
    if fellow_id not in fellows:
        return False, f"Unknown fellow ID: {fellow_id}"
    resource = find_resource(resource_id)
    if resource is None:
        return False, f"Unknown resource ID: {resource_id}"
    qty = parse_positive_int(quantity)
    if qty is None:
        return False, "Quantity must be a positive whole number."
    if qty > resource["available"]:
        return False, (f"Only {resource['available']} {resource['name']}(s) available; "
                       f"cannot lend {qty}.")
    resource["available"] -= qty
    borrow_records.append({"record_id": len(borrow_records) + 1, "fellow_id": fellow_id,
                           "resource_id": resource_id, "quantity": qty, "returned": 0})
    return True, f"{fellows[fellow_id]} borrowed {qty} x {resource['name']}."


def return_item(fellow_id, resource_id, quantity):
    if fellow_id not in fellows:
        return False, f"Unknown fellow ID: {fellow_id}"
    resource = find_resource(resource_id)
    if resource is None:
        return False, f"Unknown resource ID: {resource_id}"
    qty = parse_positive_int(quantity)
    if qty is None:
        return False, "Quantity must be a positive whole number."
    held = outstanding(fellow_id, resource_id)
    if qty > held:
        return False, (f"{fellows[fellow_id]} only has {held} {resource['name']}(s) "
                       f"on loan; cannot return {qty}.")
    remaining = qty
    for rec in borrow_records:  # oldest loans are settled first
        if remaining == 0:
            break
        if rec["fellow_id"] == fellow_id and rec["resource_id"] == resource_id:
            take = min(rec["quantity"] - rec["returned"], remaining)
            rec["returned"] += take
            remaining -= take
    resource["available"] += qty
    return True, f"{fellows[fellow_id]} returned {qty} x {resource['name']}."


# ---------- search / filter ----------
def search_by_name(term):
    term = term.strip().lower()
    return [r for r in resources if term in r["name"].lower()]


def filter_by_category(category):
    category = category.strip().lower()
    return [r for r in resources if r["category"].lower() == category]


# ---------- reports ----------
def borrowed_per_resource():
    """Units currently on loan per resource, computed from the loan records."""
    return {r["id"]: sum(rec["quantity"] - rec["returned"]
                         for rec in borrow_records if rec["resource_id"] == r["id"])
            for r in resources}


def generate_report():
    total_units = sum(r["total"] for r in resources)
    available_units = sum(r["available"] for r in resources)
    per_resource = borrowed_per_resource()
    borrowed_units = sum(per_resource.values())
    low = [r for r in resources if r["available"] < LOW_STOCK_LIMIT]
    top = max(per_resource.values(), default=0)
    leaders = [r for r in resources if per_resource[r["id"]] == top] if top > 0 else []

    print("=== INVENTORY REPORT ===")
    print(f"Total units:     {total_units}")
    print(f"Available units: {available_units}")
    print(f"Borrowed units:  {borrowed_units}")
    print(f"Low stock (fewer than {LOW_STOCK_LIMIT} available):")
    if low:
        for r in low:
            print(f"  - {r['name']} ({r['available']})")
    else:
        print("  - none")
    if leaders:
        label = "Most borrowed" if len(leaders) == 1 else "Most borrowed (tie)"
        print(f"{label}: " + ", ".join(f"{r['name']} ({top})" for r in leaders))
    else:
        print("Most borrowed: none (nothing is currently on loan)")


# ---------- persistence (bonus) ----------
def save_data(path=DATA_FILE):
    with open(path, "w") as f:
        json.dump({"resources": resources, "borrow_records": borrow_records}, f, indent=2)


def load_data(path=DATA_FILE):
    if not os.path.exists(path):
        return False
    try:
        with open(path) as f:
            data = json.load(f)
        resources[:] = data["resources"]
        borrow_records[:] = data["borrow_records"]
        return True
    except (ValueError, KeyError, OSError):
        print("Saved data unreadable; starting with default data.")
        return False


# ---------- menu ----------
def show(result):
    ok, message = result
    print(("  OK: " if ok else "  REJECTED: ") + message)


def menu():
    options = """
--- Learn2Earn Menu ---
1. Add resource      5. Search by name
2. List resources    6. Filter by category
3. Borrow            7. Report
4. Return            0. Save and exit"""
    while True:
        print(options)
        choice = input("Choose: ").strip()
        if choice == "1":
            show(add_resource(input("ID: "), input("Name: "),
                              input("Category: "), input("Total units: ")))
        elif choice == "2":
            list_resources()
        elif choice == "3":
            show(borrow(input("Fellow ID: ").strip(), input("Resource ID: ").strip(),
                        input("Quantity: ")))
        elif choice == "4":
            show(return_item(input("Fellow ID: ").strip(), input("Resource ID: ").strip(),
                             input("Quantity: ")))
        elif choice == "5":
            list_resources(search_by_name(input("Name contains: ")))
        elif choice == "6":
            list_resources(filter_by_category(input("Category: ")))
        elif choice == "7":
            generate_report()
        elif choice == "0":
            save_data()
            print("Data saved. Goodbye.")
            break
        else:
            print("  Invalid choice. Enter a number from 0 to 7.")


def run_demo():
    print("Step 1: F001 borrows 2 laptops")
    show(borrow("F001", "R001", 2))
    print("  Laptop available:", find_resource("R001")["available"])
    print("Step 2: F002 borrows 3 keyboards")
    show(borrow("F002", "R002", 3))
    print("  Keyboard available:", find_resource("R002")["available"])
    print("Step 3: F001 returns 1 laptop")
    show(return_item("F001", "R001", 1))
    print("  Laptop available:", find_resource("R001")["available"])
    print("Step 4: F003 requests 4 headsets")
    show(borrow("F003", "R003", 4))
    print("  Headset available:", find_resource("R003")["available"])
    print("Step 5: F002 tries to return 4 keyboards")
    show(return_item("F002", "R002", 4))
    print("  Keyboard available:", find_resource("R002")["available"])
    print("Step 6: Search for 'LAPtop'")
    list_resources(search_by_name("LAPtop"))
    print("Step 7: Report")
    generate_report()
    print("Extra invalid-input test: F001 borrows 'abc' laptops")
    show(borrow("F001", "R001", "abc"))
    print("  Laptop available:", find_resource("R001")["available"])


if __name__ == "__main__":
    if "--demo" in sys.argv:
        run_demo()
    else:
        if load_data():
            print("Loaded saved data.")
        menu()
        
